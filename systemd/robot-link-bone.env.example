ROBOT_LINK_LISTEN=0.0.0.0
ROBOT_LINK_PORT=5555
ROBOT_LINK_BATTERY_FILE=/run/batt_status.json
# batt_monitor owns voltage thresholds and confirmation. Robot Link forwards
# its explicit shutdown event to the Pi.
ROBOT_LINK_BATTERY_INTERVAL=1
ROBOT_LINK_BATTERY_MAX_AGE=120
ROBOT_LINK_PI_SHUTDOWN_DELAY=5
